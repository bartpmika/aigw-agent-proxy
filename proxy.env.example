# aigw-agent-proxy settings: ~/.aigw-agent-proxy/proxy.env (chmod 600).
# The proxy reads this file when it starts.

# From SCM > AI Gateway > Deployments > (your hybrid deployment) > setup details.
PORTKEY_CLIENT_AUTH=
ORGANISATIONS_TO_SYNC=
# US region values; use the ones shown for your deployment.
ALBUS_BASEPATH=https://mp.us.prod.airs-gw.portkey.ai/api
CONTROL_PLANE_BASEPATH=https://aigw.portkey.ai/v1

# Workspace API key (SCM > AI Gateway > API Keys). Requests are governed
# and logged under this key's workspace.
FORWARD_PROXY_PORTKEY_API_KEY=

# Optional
# FORWARD_PROXY_PORT=8789
# FORWARD_PROXY_CONFIG=/path/to/forward-proxy.json   # routes, metadata, web inspection
# FORWARD_PROXY_WEB_INSPECTION=0                     # don't inspect non-LLM traffic
# PORT=8787                                          # health endpoint
# FORWARD_PROXY_WEB_RESPONSES=0                      # inspect web requests only
